+def _rearrange_mixed_qkv_fused(layer, mixed_qkv):
+    """Split packed qkv and L2-normalize q/k in one Triton kernel.
+
+    ``self.rearrange_mixed_qkv`` is overridden by the model subclass
+    (``QwenGatedDeltaNetAttention``), so the fused variant is a module-level
+    helper taking the layer explicitly.  Falls back to the reference path for
+    unsupported shapes.
+    """
+    if mixed_qkv is None:
+        return None, None, None
+    tp = layer.tp_size
+    dk = layer.head_k_dim
+    dv = layer.head_v_dim
+    q_dim = layer.key_dim // tp
+    v_dim = layer.value_dim // tp
+    nk = q_dim // dk
+    nv = v_dim // dv
+    supported = (
+        mixed_qkv.dim() == 2
+        and mixed_qkv.is_contiguous()
+        and mixed_qkv.dtype in (torch.bfloat16, torch.float16)
+        and nk * dk == q_dim
+        and nv * dv == v_dim
+        and mixed_qkv.shape[1] == 2 * q_dim + v_dim
+        and all(x > 0 and (x & (x - 1)) == 0 for x in (nk, nv, dk, dv))
+    )
+    if not supported:
+        query, key, value = layer.rearrange_mixed_qkv(mixed_qkv)
+        return l2norm_fwd(query), l2norm_fwd(key), value
+    return gdn_split_qkv_norm(mixed_qkv, nk, nv, dk, dv)
+
