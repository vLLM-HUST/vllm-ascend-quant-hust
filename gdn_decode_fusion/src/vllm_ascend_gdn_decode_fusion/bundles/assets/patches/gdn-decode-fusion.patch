diff -ruN a/vllm_ascend/ops/triton/gdn_decode_fused.py b/vllm_ascend/ops/triton/gdn_decode_fused.py
--- a/vllm_ascend/ops/triton/gdn_decode_fused.py	1970-01-01 00:00:00.000000000 +0000
+++ b/vllm_ascend/ops/triton/gdn_decode_fused.py	2026-11-26 04:51:21.038384692 +0000
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 vllm-ascend-hust contributors
+"""Fused q/k/v split + q/k L2 normalization for the GDN decode path.
+
+The stock Ascend GDN path builds q/k/v with three ``reshape`` copies plus a
+``torch.cat`` (see ``rearrange_mixed_qkv``) and then launches two separate
+``l2norm_fwd`` Triton kernels.  Under graph replay that is six device kernels
+per GDN layer per step whose only job is to re-pack and rescale a few KB.
+
+This module replaces the whole sequence with one Triton kernel that reads the
+packed ``mixed_qkv`` row for one token, normalizes each q/k head row in fp32 and
+writes contiguous ``[T, Nk, Dk]`` / ``[T, Nv, Dv]`` outputs.
+"""
+
+import torch
+from vllm.triton_utils import tl, triton
+
+_L2NORM_EPS = 1e-6
+
+
+@triton.jit
+def _gdn_split_norm_kernel(
+    MQ,  # [T, S] packed q|k|v, row-contiguous
+    QO,  # [T, NK, DK]
+    KO,  # [T, NK, DK]
+    VO,  # [T, NV, DV]
+    S: tl.constexpr,
+    QD: tl.constexpr,
+    KD: tl.constexpr,
+    VD: tl.constexpr,
+    NK: tl.constexpr,
+    NV: tl.constexpr,
+    DK: tl.constexpr,
+    DV: tl.constexpr,
+    EPS: tl.constexpr,
+):
+    t = tl.program_id(0)
+    base = MQ + t * S
+
+    hk = tl.arange(0, NK)[:, None]
+    dk = tl.arange(0, DK)[None, :]
+    q_off = hk * DK + dk
+    q = tl.load(base + q_off).to(tl.float32)
+    qn = q * tl.rsqrt(tl.sum(q * q, axis=1) + EPS)[:, None]
+    tl.store(QO + t * QD + q_off, qn.to(QO.dtype.element_ty))
+
+    k_base = base + QD
+    k = tl.load(k_base + q_off).to(tl.float32)
+    kn = k * tl.rsqrt(tl.sum(k * k, axis=1) + EPS)[:, None]
+    tl.store(KO + t * QD + q_off, kn.to(KO.dtype.element_ty))
+
+    hv = tl.arange(0, NV)[:, None]
+    dv = tl.arange(0, DV)[None, :]
+    v_off = hv * DV + dv
+    v = tl.load(base + QD + KD + v_off)
+    tl.store(VO + t * VD + v_off, v)
+
+
+def gdn_split_qkv_norm(
+    mixed_qkv: torch.Tensor,
+    num_k_heads: int,
+    num_v_heads: int,
+    head_k_dim: int,
+    head_v_dim: int,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Split ``[T, q|k|v]`` into contiguous ``[1, T, H, D]`` q/k/v.
+
+    q and k are L2-normalized per head row in fp32 (same math as
+    ``l2norm_fwd`` with eps=1e-6); v is copied as-is.
+    """
+    assert mixed_qkv.dim() == 2 and mixed_qkv.is_contiguous()
+    t, s = mixed_qkv.shape
+    qd = num_k_heads * head_k_dim
+    kd = qd
+    vd = num_v_heads * head_v_dim
+    assert s == qd + kd + vd, (s, qd, kd, vd)
+    dtype = mixed_qkv.dtype
+    dev = mixed_qkv.device
+    q = torch.empty((1, t, num_k_heads, head_k_dim), dtype=dtype, device=dev)
+    k = torch.empty((1, t, num_k_heads, head_k_dim), dtype=dtype, device=dev)
+    v = torch.empty((1, t, num_v_heads, head_v_dim), dtype=dtype, device=dev)
+    if t == 0:
+        return q, k, v
+    _gdn_split_norm_kernel[(t,)](
+        mixed_qkv,
+        q,
+        k,
+        v,
+        S=s,
+        QD=qd,
+        KD=kd,
+        VD=vd,
+        NK=num_k_heads,
+        NV=num_v_heads,
+        DK=head_k_dim,
+        DV=head_v_dim,
+        EPS=_L2NORM_EPS,
+    )
+    return q, k, v
